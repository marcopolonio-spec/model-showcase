# ============================================================
# Configurazione ambiente per model-showcase
# ============================================================
# URL base delle API del backend mod-show-backend.
#
#   dev  (default): http://localhost:3000/api
#   prod (default): https://mod-show-backend.vercel.app/api
#
# Imposta VITE_API_BASE_URL per sovrascrivere i default (per esempio
# quando il backend di produzione è deployato su un URL diverso).
# Copia questo file in `.env` e scommenta/adatta la riga qui sotto.
#
# VITE_API_BASE_URL=http://localhost:3000/api

# ============================================================
# Versione dell'app (semver x.y.z)
# ============================================================
# In produzione VITE_APP_VERSION è impostata automaticamente dalla
# CI (GitHub Actions) dopo l'incremento della patch. In locale non
# serve impostarla: la build usa la versione di package.json.
#
# VITE_APP_VERSION=1.0.1
